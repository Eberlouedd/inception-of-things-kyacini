# frozen_string_literal: true

LOGIN = ENV.fetch("IOT_LOGIN", "iot")
BOX = ENV.fetch("VAGRANT_BOX", "bento/ubuntu-24.04")
PROVIDER = ENV.fetch("VAGRANT_PROVIDER", "virtualbox")

Vagrant.configure("2") do |config|
  config.vm.box = BOX
  config.ssh.insert_key = false

  config.vm.define "#{LOGIN}S" do |server|
    server.vm.hostname = "#{LOGIN}S"
    server.vm.network "private_network", ip: "192.168.56.110"
    server.vm.provider PROVIDER do |provider|
      provider.cpus = 1
      provider.memory = 1024
      provider.name = "#{LOGIN}S-p2" if provider.respond_to?(:name=)
    end
    server.vm.provision "shell", path: "scripts/server.sh"
  end
end

