# frozen_string_literal: true

require "fileutils"
require "tempfile"

LOGIN = ENV.fetch("IOT_LOGIN", "kyacini")
BOX = ENV.fetch("VAGRANT_BOX", "bento/ubuntu-24.04")

Vagrant.configure("2") do |config|
  config.vm.box = BOX
  config.ssh.insert_key = false

  config.vm.synced_folder ".", "/vagrant", type: "rsync",
    rsync__exclude: [".git/", ".vagrant/", ".k3s-token"]

  config.vm.provider "libvirt" do |provider|
    provider.driver = "qemu"
    provider.cpu_mode = "custom"
    provider.cpu_model = "qemu64"
    provider.cpu_fallback = "allow"
    provider.cpus = 1
    provider.memory = 1024
  end

  config.vm.define "#{LOGIN}S" do |server|
    server.vm.hostname = "#{LOGIN}S"
    server.vm.network "private_network", ip: "192.168.56.110"

    server.vm.provision "shell", path: "scripts/server.sh"
  end

  config.vm.define "#{LOGIN}SW" do |worker|
    worker.vm.hostname = "#{LOGIN}SW"
    worker.vm.network "private_network", ip: "192.168.56.111"

    worker.vm.provision "shell", inline: <<-'SHELL'
      install -d -m 0700 /etc/rancher/k3s
    SHELL

    worker.vm.provision "file",
      source: ".k3s-token",
      destination: "/tmp/k3s-token"

    worker.vm.provision "shell", inline: <<-'SHELL'
      install -m 0600 /tmp/k3s-token /etc/rancher/k3s/cluster-token
      rm -f /tmp/k3s-token
    SHELL

    worker.vm.provision "shell", path: "scripts/worker.sh"
  end
end
